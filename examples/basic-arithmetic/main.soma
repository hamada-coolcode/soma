
import
  lib:std
    io
      term
        output

error
  MathError
    DivisionByZero

fn
  add a: int b: int -> int
    return a + b

  sub a: int b: int -> int
    return a - b

  mul a: int b: int -> int
    return a * b

  div a: int b: int -> MathError!int
    if b == 0
      return DivisionByZero
    return a / b

  main -> !
    a = 17
    b = 5

    output(f"{a} + {b} = {add(a b)}")
    output(f"{a} - {b} = {sub(a b)}")
    output(f"{a} * {b} = {mul(a b)}")

    result = div(a b)!
    output(f"{a} / {b} = {result}")
