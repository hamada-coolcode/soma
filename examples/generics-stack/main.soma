
import
  lib:std
    io
      term
        output

error
  StackError
    EmptyStack

object
  Stack[T]
    items: T[]

    new -> Stack[T]
      return Stack(items = [])

    push item: T
      self.items.add(item)

    pop -> StackError!T
      if self.items.len() == 0
        return EmptyStack
      return self.items.pop()

    peek -> T
      return self.items.last()

    len -> int
      return self.items.len()

fn
  main -> !
    s = Stack.new[int]()
    s.push(1)
    s.push(2)
    s.push(3)
    output(f"peek: {s.peek()}")
    output(f"pop:  {s.pop()!}")
    output(f"len:  {s.len()}")

    # same generic type reused with a different T
    words = Stack.new[string]()
    words.push("hello")
    words.push("world")
    output(f"pop:  {words.pop()!}")
